# Frontend flag. Default is disabled: old keyword rules are used.
VITE_PRINT_LLM_CLASSIFIER_ENABLED=false
VITE_PRINT_LLM_CLASSIFIER_URL=http://127.0.0.1:8787/api/print/classify-personal
VITE_PRINT_LLM_LOOKUP_URL=http://127.0.0.1:8787/api/print/classifications/lookup
VITE_PRINT_LLM_CLASSIFY_MISSING_URL=http://127.0.0.1:8787/api/print/classifications/classify-missing
VITE_PRINT_LLM_MAX_CANDIDATES=300

# Local Node proxy for Ollama. No external API is used.
PRINT_LLM_CLASSIFIER_ENABLED=false
PRINT_LLM_PORT=8787
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_URL=http://localhost:11434/api/chat
PRINT_LLM_MODEL=qwen3:4b
PRINT_LLM_TIMEOUT_MS=8000
PRINT_LLM_BATCH_SIZE=20
PRINT_LLM_CACHE_ENABLED=true
PRINT_LLM_CACHE_DB_PATH=.cache/print-llm-cache.sqlite
PRINT_LLM_SCHEMA_VERSION=1
