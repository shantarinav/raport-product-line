{
  "name": "raport",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "check": "npm run typecheck && npm run test && npm run build",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "backend:print-llm": "node backend/print-llm/server.mjs",
    "backend:print-llm:evaluate": "node backend/print-llm/scripts/evaluate.mjs",
    "backend:print-llm:init:local": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy/print-llm/init-env.ps1 -Mode Local",
    "backend:print-llm:init:lan": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy/print-llm/init-env.ps1 -Mode Lan",
    "backend:print-llm:run": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy/print-llm/run.ps1",
    "backend:print-llm:start": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy/print-llm/start.ps1",
    "backend:print-llm:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy/print-llm/stop.ps1",
    "backend:print-llm:status": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy/print-llm/status.ps1"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "motion": "^12.40.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.60.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^4.1.8"
  }
}
