# Local Node proxy for Ollama. No external API is used.
PRINT_LLM_CLASSIFIER_ENABLED=false
PRINT_LLM_PORT=8787

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_URL=http://127.0.0.1:11434/api/chat
PRINT_LLM_MODEL=qwen3:4b
PRINT_LLM_TIMEOUT_MS=30000
PRINT_LLM_BATCH_SIZE=20

PRINT_LLM_CACHE_ENABLED=true
# Defaults to backend/print-llm/.cache/print-llm-cache.sqlite when unset.
PRINT_LLM_CACHE_DB_PATH=
PRINT_LLM_SCHEMA_VERSION=4
