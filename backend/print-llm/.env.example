# Local or LAN Node proxy for Ollama. No external API is used.
PRINT_LLM_CLASSIFIER_ENABLED=false
PRINT_LLM_HOST=127.0.0.1
PRINT_LLM_PORT=8787
PRINT_LLM_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional. If set, frontend must send X-Raport-Backend-Key.
PRINT_LLM_API_KEY=
PRINT_LLM_REQUEST_BODY_LIMIT_BYTES=1000000
PRINT_LLM_HTTP_REQUEST_TIMEOUT_MS=300000
PRINT_LLM_HTTP_HEADERS_TIMEOUT_MS=60000
PRINT_LLM_HTTP_KEEP_ALIVE_TIMEOUT_MS=5000

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_URL=http://127.0.0.1:11434/api/chat
PRINT_LLM_MODEL=qwen3:4b
PRINT_LLM_TIMEOUT_MS=30000
PRINT_LLM_BATCH_SIZE=20
PRINT_LLM_CONCURRENCY=1

PRINT_LLM_CACHE_ENABLED=true
# Defaults to backend/print-llm/.cache/print-llm-cache.sqlite when unset.
# Keep SQLite DB on a local disk of the backend host, not on a network share.
PRINT_LLM_CACHE_DB_PATH=
PRINT_LLM_SQLITE_BUSY_TIMEOUT_MS=5000
PRINT_LLM_SCHEMA_VERSION=4
